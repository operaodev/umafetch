{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // DO NOT EDIT: auto-generated image
        "source": "{Image}",
        "height": 11,
        "padding": {
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            // DO NOT EDIT: auto-generated color
            "keys": "{SecondaryColor}",
            "title": "{SecondaryColor}"
        },
        "key": {
            "width": 0
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            // DO NOT EDIT: auto-generated name
            "format": "\u001b[1m {Name}\u001b[0m",
            // DO NOT EDIT: auto-generated color
            "outputColor": "{PrimaryColor}"
        },
        {
            "type": "custom",
            // DO NOT EDIT: auto-generated title
            "format": "\u001b[1m󰩻 {Title}\u001b[0m",
            "outputColor": "{SecondaryColor}"
        },
        "break",
        {
            "type": "os",
            "key": " os    "
        },
        {
            "type": "kernel",
            "key": " kernel"
        },
        {
            "type": "host",
            "format": "{5} {1}",
            "key": " host  "
        },
        {
            "type": "packages",
            "key": " pkgs  "
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": " uptime"
        },
        {
            "type": "memory",
            "key": " memory"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
