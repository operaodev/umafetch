{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "{Image}", // NO EDITAR: imagen auto-generada
        "height": 11,
        "padding": {
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "{SecondaryColor}", // NO EDITAR: color auto-generado
            "title": "{SecondaryColor}"  // NO EDITAR: color auto-generado
        },
        "key": {
            "width": 0
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[1m {Name}\u001b[0m",  // NO EDITAR: nombre auto-generado
            "outputColor": "{PrimaryColor}"           // NO EDITAR: color auto-generado
        },
        {
            "type": "custom",
            "format": "\u001b[1m󰩻 {Title}\u001b[0m", // NO EDITAR: titulo auto-generado
            "outputColor": "{SecondaryColor}"
        },
        "break",
        {
            "type": "os",
            "key": " os    "
        },
        {
            "type": "kernel",
            "key": " kernel"
        },
        {
            "type": "host",
            "format": "{5} {1}",
            "key": " host  "
        },
        {
            "type": "packages",
            "key": " pkgs  "
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": " uptime"
        },
        {
            "type": "memory",
            "key": " memory"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
