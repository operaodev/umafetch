{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "{Image}", // NO EDITAR: imagen auto-generada
        "height": 27,
        "padding": {
            "left": 1
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "{SecondaryColor}", // NO EDITAR: color auto-generado
            "title": "{SecondaryColor}"  // NO EDITAR: color auto-generado
        },
        "key": {
            "width": 0
        }
    },
    "modules": [
        {separator}, // NO EDITAR: separador auto-generado
        {
            "type": "custom",
            "format": "\u001b[1m {Name}\u001b[0m",  // NO EDITAR: nombre auto-generado
            "outputColor": "{PrimaryColor}"           // NO EDITAR: color auto-generado
        },
        {
            "type": "custom",
            "format": "\u001b[1m󰩻 {Title}\u001b[0m", // NO EDITAR: titulo auto-generado
            "outputColor": "{SecondaryColor}"
        },
        "break",
        {SloganLines}, // NO EDITAR: slogan auto-generado
        {BioLines},    // NO EDITAR: perfil auto-generado
        {separator},
        "title",
        "break",
        {
            "type": "os",
            "key": " OS      "
        },
        {
            "type": "host",
            "key": " Host    "
        },
        {
            "type": "kernel",
            "key": " Kernel  "
        },
        {
            "type": "uptime",
            "key": " Uptime  "
        },
        "break",
        {
            "type": "packages",
            "key": " Packages"
        },
        {
            "type": "shell",
            "key": " Shell   "
        },
        {
            "type": "display",
            "key": " Display "
        },
        {
            "type": "wm",
            "key": " WM      "
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        "break",
        {
            "type": "cpu",
            "key": " CPU     ",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": " GPU     "
        },
        {
            "type": "memory",
            "key": " Memory  "
        },
        {
            "type": "disk",
            "key": " Disk    "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
